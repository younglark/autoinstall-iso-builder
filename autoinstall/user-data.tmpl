#cloud-config
# ---------------------------------------------------------------------------
# Ubuntu Server 22.04 / 24.04 autoinstall 配置模板
#
# 所有双 @ 包裹的占位符由 tools/render-user-data.py 自动替换, 不要手工改这里。
# apt.primary 用 legacy 格式以兼容 22.04; 全离线时 primary 为空列表 + offline offline-install。
# ---------------------------------------------------------------------------
autoinstall:
  version: 1

@@INTERACTIVE_SECTIONS_BLOCK@@

  locale: @@LOCALE@@
  keyboard:
    layout: @@KEYBOARD@@

  timezone: @@TIMEZONE@@

@@NETWORK_BLOCK@@
  identity:
    hostname: @@HOSTNAME@@
    username: @@USERNAME@@
    password: "@@PASSWORD_HASH@@"

  ssh:
    install-server: true
    allow-pw: @@SSH_ALLOW_PW@@
    authorized-keys:
@@SSH_AUTHORIZED_KEYS_BLOCK@@

  apt:
    geoip: false
    preserve_sources_list: false
@@APT_PRIMARY_BLOCK@@
    fallback: @@APT_FALLBACK@@

  refresh-installer:
    update: false

  updates: @@UPDATES@@

  storage:
    layout:
      name: @@STORAGE_LAYOUT@@
      match:
        size: largest

  packages:
@@PACKAGES_BLOCK@@

  late-commands:
@@LATE_COMMANDS_BLOCK@@

  error-commands:
    - [sh, -c, "mkdir -p /target/var/log/autoinstall && cp -a /var/log/installer /target/var/log/autoinstall/ 2>/dev/null || true"]

  shutdown: reboot
